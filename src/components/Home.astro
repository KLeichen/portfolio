---
import { getCollection } from 'astro:content';
import { t, contact, projectPath, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;

const projects = (await getCollection('projects', (p) => p.data.lang === lang))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const icon = {
  chart: '<path d="M3 3v18h18"/><path d="m7 15 4-4 3 3 5-6"/>',
  brain: '<circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8"/>',
  layout: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  download: '<path d="M12 3v12M7 10l5 5 5-5M5 21h14"/>',
  github: '<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>',
  chat: '<path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.6A8.4 8.4 0 1 1 21 11.5z"/>',
};
const svg = (d: string, size = 22) =>
  `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;

const services = [
  ['services.1.t', 'services.1.d', icon.chart],
  ['services.2.t', 'services.2.d', icon.brain],
  ['services.3.t', 'services.3.d', icon.layout],
] as const;

const tools = ['Python', 'pandas', 'scikit-learn', 'SQL', 'R', 'Jupyter', 'Git'];
const cvHref = '/cv/Kevin_Leichen_CV_ES.pdf';
const es = lang === 'es';
const timeline = [
  { when: es ? '2024 – hoy' : '2024 – now', what: es ? 'Lic. en Ciencias de Datos' : 'BSc in Data Science', where: 'Universidad Austral' },
  { when: es ? 'Ene 2025' : 'Jan 2025', what: 'Data & Cataloging Assistant', where: es ? 'Empresa numismática' : 'Numismatics company' },
  { when: es ? 'Ene – Feb 2024' : 'Jan – Feb 2024', what: 'Data Operations Analyst', where: es ? 'Plataforma de restaurantes' : 'Restaurant platform' },
];
---

<section class="hero">
  <div class="container hero-grid">
    <div>
      <p class="hello">{t(lang, 'hero.hello')}</p>
      <h1>{t(lang, 'hero.name')}<br /><span>{t(lang, 'hero.role')}</span></h1>
      <p class="pitch">{t(lang, 'hero.pitch')}</p>
      <div class="ctas">
        <a class="btn btn-primary" href="#contact">{t(lang, 'hero.cta')} <Fragment set:html={svg(icon.arrow, 18)} /></a>
        <a class="btn btn-ghost" href={cvHref} download>{t(lang, 'hero.cv')} <Fragment set:html={svg(icon.download, 18)} /></a>
      </div>
    </div>
    <div class="photo-wrap">
      <div class="ring"></div>
      <img src="/photo.png" alt="Kevin Leichen" width="600" height="600" />
    </div>
  </div>
</section>

<section id="services" class="alt">
  <div class="container">
    <div class="section-head">
      <h2>{t(lang, 'services.title')}</h2>
      <p>{t(lang, 'services.sub')}</p>
    </div>
    <div class="grid3">
      {services.map(([title, desc, ic]) => (
        <div class="card service">
          <div class="icon-box"><Fragment set:html={svg(ic, 26)} /></div>
          <h3>{t(lang, title)}</h3>
          <p class="muted">{t(lang, desc)}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="projects">
  <div class="container">
    <div class="section-head">
      <h2>{t(lang, 'projects.title')}</h2>
      <p>{t(lang, 'projects.sub')}</p>
    </div>
    <div class="grid3">
      {projects.map((p) => (
        <a class="card project" href={projectPath(lang, p.data.page)}>
          <div class="cover">
            <img src={p.data.cover} alt="" loading="lazy" />
            <div class="overlay"><span class="btn btn-primary">{t(lang, 'projects.view')}</span></div>
          </div>
          <div class="body">
            <h3>{p.data.title}</h3>
            <p class="muted">{p.data.summary}</p>
            <div class="chips">{p.data.tools.slice(0, 4).map((tool) => <span class="chip">{tool}</span>)}</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="tools alt">
  <div class="container tools-row">
    <span class="tools-label">{t(lang, 'tools.title')}</span>
    {tools.map((tool) => <span class="tool">{tool}</span>)}
  </div>
</section>

<section id="about">
  <div class="container about-grid">
    <ol class="card timeline">
      {timeline.map((item) => (
        <li><span class="when">{item.when}</span><strong>{item.what}</strong><span class="muted">{item.where}</span></li>
      ))}
    </ol>
    <div>
      <h2 class="bar-title">{t(lang, 'about.title')}</h2>
      <p class="muted">{t(lang, 'about.p1')}</p>
      <p class="muted">{t(lang, 'about.p2')}</p>
      <p class="muted">{t(lang, 'about.p3')}</p>
      <div class="stats">
        <div class="card stat"><strong>{t(lang, 'about.year')}</strong><span>{t(lang, 'about.stat1')}</span></div>
        <div class="card stat"><strong>{projects.length}</strong><span>{t(lang, 'about.stat2')}</span></div>
        <div class="card stat"><strong>C1</strong><span>{t(lang, 'about.stat3')}</span></div>
      </div>
    </div>
  </div>
</section>

<section id="contact" class="alt">
  <div class="container narrow">
    <div class="section-head">
      <h2>{t(lang, 'contact.title')}</h2>
      <p>{t(lang, 'contact.sub')}</p>
    </div>
    <form class="card form" id="contact-form" data-key={contact.web3formsKey} data-mail={contact.email}
      data-sending={t(lang, 'contact.sending')} data-ok={t(lang, 'contact.ok')} data-err={t(lang, 'contact.err')}>
      <div class="row">
        <label>{t(lang, 'contact.name')}<input name="name" required autocomplete="name" /></label>
        <label>{t(lang, 'contact.email')}<input name="email" type="email" required autocomplete="email" /></label>
      </div>
      <label>{t(lang, 'contact.message')}<textarea name="message" rows="5" required></textarea></label>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">{t(lang, 'contact.send')}</button>
        <a class="btn btn-ghost" href={`https://wa.me/${contact.whatsapp}`} target="_blank" rel="noopener">
          <Fragment set:html={svg(icon.chat, 18)} /> {t(lang, 'contact.whatsapp')}
        </a>
      </div>
      <p class="status" aria-live="polite"></p>
    </form>
    <p class="socials"><a href={contact.github} target="_blank" rel="noopener"><Fragment set:html={svg(icon.github, 20)} /> GitHub</a></p>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = form.querySelector('.status') as HTMLElement;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = form.dataset;
    const data = new FormData(form);
    if (!d.key) {
      // No form service key yet: open the visitor's email app instead.
      const body = `${data.get('message')}\n\n${data.get('name')} <${data.get('email')}>`;
      location.href = `mailto:${d.mail}?subject=${encodeURIComponent('Portfolio: ' + data.get('name'))}&body=${encodeURIComponent(body)}`;
      return;
    }
    status.textContent = d.sending!;
    data.append('access_key', d.key);
    data.append('subject', 'Portfolio: ' + data.get('name'));
    try {
      const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: data });
      if (!res.ok) throw new Error();
      status.textContent = d.ok!;
      form.reset();
    } catch {
      status.textContent = d.err!;
    }
  });
</script>

<style>
  .hero { padding: 72px 0 96px; }
  .hero-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: center; }
  .hello { color: var(--accent); font-weight: 600; font-size: 1.15rem; margin: 0 0 12px; }
  h1 { font-size: clamp(2.6rem, 6vw, 4.2rem); font-weight: 800; }
  h1 span { color: var(--accent); }
  .pitch { color: var(--muted); font-size: 1.15rem; max-width: 34em; margin: 24px 0 36px; }
  .ctas { display: flex; gap: 16px; flex-wrap: wrap; }
  .photo-wrap { position: relative; width: min(100%, 400px); aspect-ratio: 1; justify-self: center; }
  .photo-wrap img { position: absolute; inset: 18px; width: calc(100% - 36px); height: calc(100% - 36px); border-radius: 50%; object-fit: cover; }
  .ring { position: absolute; inset: 0; border-radius: 50%; border: 2px solid var(--accent); opacity: .5; }
  .ring::after { content: ''; position: absolute; inset: -14px; border-radius: 50%; border: 1px dashed var(--border); }

  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .service { padding: 32px; }
  .service h3 { font-size: 1.3rem; margin: 22px 0 10px; }
  .service p { margin: 0; }

  .project { overflow: hidden; transition: border-color .2s, transform .2s; display: flex; flex-direction: column; }
  .project:hover { border-color: var(--accent); transform: translateY(-4px); }
  .cover { position: relative; aspect-ratio: 16 / 10; background: var(--surface); border-bottom: 1px solid var(--border); }
  .cover img { width: 100%; height: 100%; object-fit: contain; }
  .overlay { position: absolute; inset: 0; background: rgba(17, 26, 34, .7); display: grid; place-items: center; opacity: 0; transition: opacity .2s; }
  .project:hover .overlay, .project:focus-visible .overlay { opacity: 1; }
  .body { padding: 24px; }
  .body h3 { font-size: 1.25rem; margin-bottom: 8px; }
  .project:hover h3 { color: var(--accent); }
  .body p { margin: 0 0 16px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }

  .tools { padding: 40px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .tools-row { display: flex; flex-wrap: wrap; gap: 14px 36px; justify-content: center; align-items: center; }
  .tools-label { color: var(--accent); font-weight: 600; text-transform: uppercase; font-size: .85rem; letter-spacing: .1em; }
  .tool { color: var(--muted); font-weight: 600; font-size: 1.05rem; }

  .about-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 64px; align-items: center; }
  .timeline { list-style: none; margin: 0; padding: 28px 28px 28px 44px; display: grid; gap: 26px; position: relative; }
  .timeline::before { content: ''; position: absolute; left: 28px; top: 36px; bottom: 36px; width: 2px; background: var(--border); }
  .timeline li { position: relative; display: grid; gap: 2px; }
  .timeline li::before { content: ''; position: absolute; left: -21px; top: 8px; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }
  .when { color: var(--accent); font-size: .85rem; font-weight: 600; }
  .bar-title { font-size: clamp(2rem, 4vw, 2.75rem); border-left: 4px solid var(--accent); padding-left: 18px; margin-bottom: 24px; }
  .about-grid p { font-size: 1.08rem; }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 32px; }
  .stat { padding: 22px 12px; text-align: center; }
  .stat strong { display: block; font-size: 2rem; color: var(--accent); }
  .stat span { color: var(--muted); font-size: .9rem; }

  .narrow { max-width: 760px; }
  .form { padding: 32px; display: grid; gap: 18px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  label { display: grid; gap: 8px; font-weight: 500; font-size: .95rem; }
  input, textarea {
    background: var(--bg); border: 1px solid var(--border); border-radius: 10px;
    padding: 12px 14px; color: var(--text); font: inherit; resize: vertical;
  }
  input:focus, textarea:focus { outline: 2px solid var(--accent); border-color: transparent; }
  .form-actions { display: flex; gap: 16px; flex-wrap: wrap; }
  .status { margin: 0; color: var(--accent); min-height: 1.6em; }
  .socials { text-align: center; margin-top: 28px; }
  .socials a { display: inline-flex; gap: 8px; align-items: center; color: var(--muted); }
  .socials a:hover { color: var(--accent); }

  @media (max-width: 900px) {
    .hero-grid, .about-grid { grid-template-columns: 1fr; }
    .photo-wrap { order: -1; width: min(70%, 300px); }
    .timeline { order: 2; }
    .grid3 { grid-template-columns: 1fr; }
    .row { grid-template-columns: 1fr; }
  }
</style>
