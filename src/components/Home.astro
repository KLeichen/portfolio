---
import { getCollection } from 'astro:content';
import { t, contact, projectPath, type Lang } from '../i18n/ui';
import { themes, fallbackTheme, heroMetrics, process, toolGroups, copy } from '../data/showcase';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];

const projects = (await getCollection('projects', (p) => p.data.lang === lang))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const byPage = new Map(projects.map((p) => [p.data.page, p]));
const theme = (page: string) => themes[page] ?? fallbackTheme;

// Hero chart only shows projects that are published in this build.
const metrics = heroMetrics.filter((m) => byPage.has(m.page));

const icon = {
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  download: '<path d="M12 3v12M7 10l5 5 5-5M5 21h14"/>',
  github: '<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>',
  chat: '<path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.6A8.4 8.4 0 1 1 21 11.5z"/>',
  play: '<rect x="3" y="4" width="18" height="14" rx="2"/><path d="m10 9 5 2.5-5 2.5z"/>',
};
const svg = (d: string, size = 18) =>
  `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;

const toolUse = (tool: string) =>
  projects.filter((p) => p.data.tools.some((x) => x.toLowerCase() === tool.toLowerCase())).length;

const cvHref = '/cv/Kevin_Leichen_CV_ES.pdf';
const es = lang === 'es';
const timeline = [
  { when: es ? '2024 – hoy' : '2024 – now', what: es ? 'Lic. en Ciencias de Datos' : 'BSc in Data Science', where: 'Universidad Austral' },
  { when: es ? 'Ene 2025' : 'Jan 2025', what: 'Data & Cataloging Assistant', where: es ? 'Empresa numismática' : 'Numismatics company' },
  { when: es ? 'Ene – Feb 2024' : 'Jan – Feb 2024', what: 'Data Operations Analyst', where: es ? 'Plataforma de restaurantes' : 'Restaurant platform' },
];
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="who reveal">
        <img src="/photo.png" alt="Kevin Leichen" width="56" height="56" />
        <div>
          <p class="who-line">{c.eyebrow}</p>
          <p class="status"><span class="dot"></span>{c.status}</p>
        </div>
      </div>
      <h1 class="reveal" style="--d:80ms">{c.nameA} <em>{c.nameB}</em></h1>
      <p class="lede reveal" style="--d:160ms">{c.lede} <em>{c.ledeEm}</em></p>
      <p class="pitch reveal" style="--d:220ms">{c.pitch}</p>
      <div class="ctas reveal" style="--d:280ms">
        <a class="btn btn-primary" href="#projects">{c.seeCases} <Fragment set:html={svg(icon.arrow)} /></a>
        <a class="btn btn-ghost" href="#contact">{t(lang, 'hero.cta')}</a>
        <a class="btn btn-ghost" href={cvHref} download>{t(lang, 'hero.cv')} <Fragment set:html={svg(icon.download)} /></a>
      </div>
    </div>

    {metrics.length > 0 && (
      <figure class="chart card reveal" style="--d:200ms" aria-label={c.chartTitle}>
        <figcaption>
          <span class="chart-title">{c.chartTitle}</span>
          <span class="legend">
            <span><i class="lg before"></i>{c.chartBefore}</span>
            <span><i class="lg after"></i>{c.chartAfter}</span>
          </span>
        </figcaption>
        <div class="rows">
          {metrics.map((m, i) => {
            const th = theme(m.page);
            const p = byPage.get(m.page)!;
            return (
              <a class="row" href={projectPath(lang, m.page)} style={`--c:${th.accent};--b:${m.before}%;--a:${m.after}%;--i:${i}`}
                data-title={p.data.title} data-label={m.label[lang]} data-before={m.beforeLabel[lang]}
                data-after={m.afterLabel[lang]} data-detail={m.detail[lang]}>
                <span class="row-label"><span class="row-field">{th.field[lang]}</span>{m.label[lang]}</span>
                <span class="track">
                  <span class="span"></span>
                  <span class="pt before"></span>
                  <span class="pt after"><span class="val">{Math.round(m.after)}%</span></span>
                </span>
              </a>
            );
          })}
        </div>
        <div class="axis" aria-hidden="true"><span>0</span><span>25</span><span>50</span><span>75</span><span>100%</span></div>
        <div class="detail" aria-live="polite" style={`--c:${theme(metrics[0].page).accent}`}>
          <div class="tt-title">{byPage.get(metrics[0].page)!.data.title}</div>
          <div class="tt-ba"><span class="tt-before">{metrics[0].beforeLabel[lang]}</span><span class="tt-after">{metrics[0].afterLabel[lang]}</span></div>
          <div class="tt-detail">{metrics[0].detail[lang]}</div>
        </div>
        <p class="hint">{c.chartHint}</p>
      </figure>
    )}
  </div>
</section>

<section id="projects" class="alt">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">{c.projectsEyebrow}</p>
      <h2>{c.projectsTitle}</h2>
      <p>{c.projectsSub}</p>
    </div>
    <div class="cases">
      {projects.map((p, i) => {
        const th = theme(p.data.page);
        return (
          <a class="case reveal" href={projectPath(lang, p.data.page)} style={`--c:${th.accent};--paper:${th.paper}`}>
            <div class="case-cover">
              <img src={p.data.cover} alt="" loading="lazy" />
              {p.data.embed && <span class="tool-badge"><Fragment set:html={svg(icon.play, 15)} />{c.tryTool}</span>}
            </div>
            <div class="case-body">
              <p class="case-meta"><span class="num">{pad(projects.length - i)}</span>{th.field[lang]} · {th.method[lang]}</p>
              <h3>{p.data.title}</h3>
              <p class="case-sum">{p.data.summary}</p>
              {p.data.highlights.length > 0 && (
                <dl class="kpis">
                  {p.data.highlights.slice(0, 3).map((h) => (
                    <div class="kpi"><dt data-count={h.value}>{h.value}</dt><dd>{h.label}</dd></div>
                  ))}
                </dl>
              )}
              <div class="case-foot">
                <div class="chips">{p.data.tools.slice(0, 5).map((tool) => <span class="chip">{tool}</span>)}</div>
                <span class="go">{c.open} <Fragment set:html={svg(icon.arrow)} /></span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<section id="services">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">{c.processEyebrow}</p>
      <h2>{c.processTitle}</h2>
      <p>{t(lang, 'services.sub')}</p>
    </div>
    <ol class="steps">
      {process.map((s, i) => (
        <li class="step reveal" style={`--d:${i * 90}ms`}>
          <span class="step-n">{pad(i + 1)}</span>
          <h3>{s.title[lang]}</h3>
          <p>{s.desc[lang]}</p>
          <span class="step-ex">{c.example} {s.example[lang]}</span>
        </li>
      ))}
    </ol>

    <div class="toolbox reveal">
      <p class="eyebrow">{c.toolsEyebrow}</p>
      <div class="groups">
        {toolGroups.map((g) => (
          <div class="group">
            <span class="group-name">{g.name[lang]}</span>
            <div class="group-tools">
              {g.tools.map((tool) => {
                const n = toolUse(tool);
                return <span class:list={['tool', { used: n > 0 }]} data-tip={c.usedIn(n)} tabindex="0">{tool}{n > 0 && <sup>{n}</sup>}</span>;
              })}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section id="about" class="alt">
  <div class="container about-grid">
    <div class="portrait reveal">
      <img src="/photo.png" alt="Kevin Leichen" width="600" height="600" loading="lazy" />
    </div>
    <div class="about-copy">
      <p class="eyebrow reveal">{c.aboutEyebrow}</p>
      <h2 class="reveal">{t(lang, 'about.title')}</h2>
      <p class="reveal">{t(lang, 'about.p1')}</p>
      <p class="reveal">{t(lang, 'about.p2')}</p>
      <p class="reveal">{t(lang, 'about.p3')}</p>
      <div class="stats reveal">
        <div class="stat"><strong>{t(lang, 'about.year')}</strong><span>{t(lang, 'about.stat1')}</span></div>
        <div class="stat"><strong data-count={String(projects.length)}>{projects.length}</strong><span>{t(lang, 'about.stat2')}</span></div>
        <div class="stat"><strong>C1</strong><span>{t(lang, 'about.stat3')}</span></div>
      </div>
    </div>
    <ol class="timeline reveal">
      {timeline.map((item) => (
        <li><span class="when">{item.when}</span><strong>{item.what}</strong><span class="muted">{item.where}</span></li>
      ))}
    </ol>
  </div>
</section>

<section id="contact">
  <div class="container contact-grid">
    <div class="reveal">
      <p class="eyebrow">{c.contactEyebrow}</p>
      <h2 class="contact-title">{c.contactTitle}</h2>
      <p class="muted contact-sub">{c.contactSub}</p>
      <div class="direct">
        <a class="btn btn-ghost" href={`https://wa.me/${contact.whatsapp}`} target="_blank" rel="noopener">
          <Fragment set:html={svg(icon.chat)} /> {t(lang, 'contact.whatsapp')}
        </a>
        <a class="btn btn-ghost" href={contact.github} target="_blank" rel="noopener"><Fragment set:html={svg(icon.github)} /> GitHub</a>
      </div>
    </div>
    <form class="card form reveal" id="contact-form" data-key={contact.web3formsKey} data-mail={contact.email}
      data-sending={t(lang, 'contact.sending')} data-ok={t(lang, 'contact.ok')} data-err={t(lang, 'contact.err')}>
      <div class="frow">
        <label>{t(lang, 'contact.name')}<input name="name" required autocomplete="name" /></label>
        <label>{t(lang, 'contact.email')}<input name="email" type="email" required autocomplete="email" /></label>
      </div>
      <label>{t(lang, 'contact.message')}<textarea name="message" rows="5" required></textarea></label>
      <button class="btn btn-primary" type="submit">{t(lang, 'contact.send')} <Fragment set:html={svg(icon.arrow)} /></button>
      <p class="fstatus" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  // Contact form
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = form.querySelector('.fstatus') as HTMLElement;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = form.dataset;
    const data = new FormData(form);
    if (!d.key) {
      // No form service key yet: open the visitor's email app instead.
      const body = `${data.get('message')}\n\n${data.get('name')} <${data.get('email')}>`;
      location.href = `mailto:${d.mail}?subject=${encodeURIComponent('Portfolio: ' + data.get('name'))}&body=${encodeURIComponent(body)}`;
      return;
    }
    status.textContent = d.sending!;
    data.append('access_key', d.key);
    data.append('subject', 'Portfolio: ' + data.get('name'));
    try {
      const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: data });
      if (!res.ok) throw new Error();
      status.textContent = d.ok!;
      form.reset();
    } catch {
      status.textContent = d.err!;
    }
  });

  // Hero chart: hovering a row fills the detail panel under the chart.
  const chart = document.querySelector('.chart') as HTMLElement | null;
  if (chart) {
    const panel = chart.querySelector('.detail') as HTMLElement;
    const set = (sel: string, text: string) => { (panel.querySelector(sel) as HTMLElement).textContent = text; };
    const show = (row: HTMLElement) => {
      const d = row.dataset;
      set('.tt-title', d.title!); set('.tt-before', d.before!); set('.tt-after', d.after!); set('.tt-detail', d.detail!);
      panel.style.setProperty('--c', getComputedStyle(row).getPropertyValue('--c'));
      chart.classList.add('focus');
      chart.querySelectorAll('.row').forEach((r) => r.classList.toggle('on', r === row));
    };
    chart.querySelectorAll<HTMLElement>('.row').forEach((row) => {
      row.addEventListener('mouseenter', () => show(row));
      row.addEventListener('focus', () => show(row));
    });
    chart.addEventListener('mouseleave', () => chart.classList.remove('focus'));
  }

  // Count-up for numbers like "48%", "+6.9%", "−$670k" when they scroll into view.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const re = /^([+−-]?\$?)(\d+(?:\.\d+)?)(%|k)?$/;
  const counters = [...document.querySelectorAll<HTMLElement>('[data-count]')].filter((el) => re.test(el.dataset.count!));
  const run = (el: HTMLElement) => {
    const [, pre, num, suf = ''] = el.dataset.count!.match(re)!;
    const target = parseFloat(num), dec = (num.split('.')[1] || '').length, t0 = performance.now();
    const tick = (now: number) => {
      const k = Math.min(1, (now - t0) / 1100), e = 1 - Math.pow(1 - k, 3);
      el.textContent = pre + (target * e).toFixed(dec) + suf;
      if (k < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  if (!reduce) {
    const cio = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { run(e.target as HTMLElement); cio.unobserve(e.target); } }), { threshold: .6 });
    counters.forEach((el) => cio.observe(el));
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero { padding: 72px 0 104px; overflow: hidden; }
  .hero-bg {
    position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(rgba(147, 165, 181, .16) 1px, transparent 1px);
    background-size: 26px 26px;
    mask-image: radial-gradient(ellipse 70% 70% at 70% 40%, #000 20%, transparent 75%);
  }
  .hero-bg::after {
    content: ''; position: absolute; width: 620px; height: 620px; right: -120px; top: -160px; border-radius: 50%;
    background: radial-gradient(circle, rgba(79, 209, 197, .16), transparent 65%);
  }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 64px; align-items: center; position: relative; }
  .who { display: flex; align-items: center; gap: 14px; margin-bottom: 30px; }
  .who img { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent); }
  .who p { margin: 0; }
  .who-line { font-family: var(--mono); font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .status { display: flex; align-items: center; gap: 8px; font-size: .92rem; font-weight: 500; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #5ee08a; box-shadow: 0 0 0 0 rgba(94, 224, 138, .6); animation: pulse 2.4s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 8px rgba(94, 224, 138, 0); } 100% { box-shadow: 0 0 0 0 rgba(94, 224, 138, 0); } }
  h1 { font-size: clamp(3.6rem, 9vw, 7.2rem); line-height: .92; letter-spacing: -0.02em; }
  h1 em, .lede em { font-style: italic; color: var(--accent); }
  .lede { font-family: var(--serif); font-size: clamp(1.6rem, 2.8vw, 2.2rem); line-height: 1.2; margin: 26px 0 16px; max-width: 18em; }
  .pitch { color: var(--muted); font-size: 1.08rem; max-width: 32em; margin: 0 0 34px; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; }

  /* Hero chart: dumbbell, before → after */
  .chart { position: relative; margin: 0; padding: 26px 26px 18px; background: linear-gradient(180deg, var(--surface), rgba(23, 34, 44, .7)); box-shadow: 0 30px 80px -40px rgba(0, 0, 0, .8); }
  figcaption { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }
  .chart-title { font-family: var(--serif); font-size: 1.45rem; }
  .legend { display: flex; gap: 16px; font-size: .78rem; color: var(--muted); font-family: var(--mono); }
  .legend span { display: inline-flex; align-items: center; gap: 6px; }
  .lg { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .lg.before { border: 2px solid var(--faint); }
  .lg.after { background: var(--accent); }
  .rows { display: grid; gap: 6px; }
  .row { display: grid; gap: 8px; padding: 10px 10px 12px; margin: 0 -10px; border-radius: 10px; transition: background .2s, opacity .25s; }
  .chart.focus .row:not(.on) { opacity: .4; }
  .row.on { background: var(--surface-2); }
  .row-label { font-size: .9rem; display: flex; flex-direction: column; }
  .row-field { font-family: var(--mono); font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; color: var(--c); }
  .track {
    position: relative; height: 18px; margin-right: 44px;
    background: repeating-linear-gradient(90deg, var(--border-soft) 0 1px, transparent 1px 25%);
    background-size: calc(100% + 1px) 100%;
  }
  .track::before { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: var(--border); }
  .span { position: absolute; top: 50%; height: 4px; margin-top: -2px; left: var(--b); width: calc(var(--a) - var(--b)); background: linear-gradient(90deg, rgba(147, 165, 181, .25), var(--c)); border-radius: 2px; transform-origin: 0 50%; }
  .pt { position: absolute; top: 50%; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%; }
  .pt.before { left: var(--b); background: var(--bg); border: 2px solid var(--faint); }
  .pt.after { left: var(--a); background: var(--c); box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 25%, transparent); }
  .val { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); font-family: var(--mono); font-size: .78rem; color: var(--c); font-weight: 500; }
  .js .chart .span { transform: scaleX(0); transition: transform 1s var(--ease); transition-delay: calc(400ms + var(--i) * 140ms); }
  .js .chart .pt.after { left: var(--b); transition: left 1s var(--ease); transition-delay: calc(400ms + var(--i) * 140ms); }
  .js .chart.in .span { transform: none; }
  .js .chart.in .pt.after { left: var(--a); }
  .axis { display: flex; justify-content: space-between; margin: 6px 44px 0 0; font-family: var(--mono); font-size: .68rem; color: var(--faint); }
  .hint { margin: 14px 0 0; font-size: .78rem; color: var(--faint); }
  .detail {
    margin-top: 18px; padding: 14px 16px; border-radius: 12px; background: rgba(11, 17, 22, .6);
    border: 1px solid var(--border-soft); border-left: 3px solid var(--c); font-size: .88rem; transition: border-color .25s;
  }
  .tt-title { font-family: var(--serif); font-size: 1.15rem; margin-bottom: 6px; }
  .tt-ba { display: flex; flex-wrap: wrap; gap: 4px 18px; }
  .tt-before { color: var(--muted); }
  .tt-before::before { content: '○ '; }
  .tt-after { color: var(--c); font-weight: 600; }
  .tt-after::before { content: '● '; }
  .tt-detail { margin-top: 6px; color: var(--text); opacity: .8; }

  /* ---------- Case studies ---------- */
  .cases { display: grid; gap: 28px; }
  .case {
    display: grid; grid-template-columns: 1fr 1.15fr; border-radius: 20px; overflow: hidden;
    background: var(--surface); border: 1px solid var(--border-soft); position: relative;
    transition: border-color .3s, transform .4s var(--ease), box-shadow .4s;
  }
  .case::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--c); z-index: 1; }
  .case:nth-child(even) { grid-template-columns: 1.15fr 1fr; }
  .case:nth-child(even) .case-cover { order: 2; }
  .case:hover { border-color: color-mix(in srgb, var(--c) 55%, transparent); transform: translateY(-4px); box-shadow: 0 30px 60px -40px color-mix(in srgb, var(--c) 70%, transparent); }
  .case-cover { background: var(--paper); position: relative; display: grid; place-items: center; padding: 28px; min-height: 300px; }
  .case-cover img { width: 100%; height: 100%; max-height: 340px; object-fit: contain; transition: transform .6s var(--ease); }
  .case:hover .case-cover img { transform: scale(1.03); }
  .tool-badge {
    position: absolute; left: 16px; bottom: 16px; display: inline-flex; align-items: center; gap: 6px;
    background: rgba(14, 21, 27, .86); color: #fff; font-size: .74rem; padding: 6px 11px; border-radius: 999px; font-weight: 500;
  }
  .case-body { padding: 36px 40px; display: flex; flex-direction: column; }
  .case-meta { font-family: var(--mono); font-size: .74rem; letter-spacing: .1em; text-transform: uppercase; color: var(--c); margin: 0 0 14px; display: flex; gap: 12px; align-items: center; }
  .num { color: var(--faint); }
  .case h3 { font-family: var(--serif); font-size: clamp(1.8rem, 3vw, 2.4rem); }
  .case-sum { color: var(--muted); margin: 14px 0 24px; }
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin: 0 0 26px; padding: 18px 0; border-top: 1px solid var(--border-soft); border-bottom: 1px solid var(--border-soft); }
  .kpi dt { font-family: var(--serif); font-size: 2rem; line-height: 1; color: var(--c); white-space: nowrap; }
  .kpi dd { margin: 8px 0 0; font-size: .8rem; color: var(--muted); line-height: 1.4; }
  .case-foot { margin-top: auto; display: flex; justify-content: space-between; align-items: center; gap: 14px; flex-wrap: wrap; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .case .chip { background: color-mix(in srgb, var(--c) 13%, transparent); color: var(--c); }
  .go { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--text); }
  .go :global(svg) { transition: transform .3s var(--ease); }
  .case:hover .go { color: var(--c); }
  .case:hover .go :global(svg) { transform: translateX(4px); }

  /* ---------- Process + tools ---------- */
