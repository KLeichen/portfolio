---
import { getCollection } from 'astro:content';
import { t, contact, projectPath, type Lang } from '../i18n/ui';
import { themes, fallbackTheme, heroMetrics, process, processFns, toolGroups, career, copy } from '../data/showcase';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];

const projects = (await getCollection('projects', (p) => p.data.lang === lang))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const byPage = new Map(projects.map((p) => [p.data.page, p]));
const theme = (page: string) => themes[page] ?? fallbackTheme;
const metrics = heroMetrics.filter((m) => byPage.has(m.page));

// Tools × cases matrix, from the projects' own frontmatter.
const norm = (s: string) => s.toLowerCase();
const allTools = new Map<string, string>();
projects.forEach((p) => p.data.tools.forEach((tool) => { if (!allTools.has(norm(tool))) allTools.set(norm(tool), tool); }));
const usedBy = (tool: string) => projects.filter((p) => p.data.tools.some((x) => norm(x) === norm(tool)));
const heatRows = [...allTools.values()]
  .map((tool) => ({ tool, cases: usedBy(tool) }))
  .sort((a, b) => b.cases.length - a.cases.length || a.tool.localeCompare(b.tool));
const alsoUse = toolGroups.flatMap((g) => g.tools).filter((tool) => !allTools.has(norm(tool)));

// Gantt: Jan 2024 to the build month.
const now = new Date();
const monthIdx = (ym: string) => { const [y, m] = ym.split('-').map(Number); return (y - 2024) * 12 + (m - 1); };
const nowIdx = (now.getFullYear() - 2024) * 12 + now.getMonth();
const span = nowIdx + 1;
const years = Array.from({ length: now.getFullYear() - 2024 + 1 }, (_, i) => 2024 + i);

const cvHref = '/cv/Kevin_Leichen_CV_ES.pdf';
const icon = {
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  download: '<path d="M12 3v12M7 10l5 5 5-5M5 21h14"/>',
  github: '<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>',
  chat: '<path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.6A8.4 8.4 0 1 1 21 11.5z"/>',
};
const svg = (d: string, size = 18) =>
  `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
---

<!-- ===== Hero: a notebook cell and Fig. 1 ===== -->
<section class="hero">
  <div class="container hero-grid">
    <div class="nb">
      <div class="cell-in reveal">
        <span class="prompt">In&nbsp;[1]:</span>
        <pre class="code"><code><span class="kw">from</span> kevin_leichen <span class="kw">import</span> DataScientist
kevin = <span class="fn">DataScientist</span>(
    city=<span class="str">"Buenos Aires"</span>,
    status=<span class="str">"{c.status}"</span>,
)
kevin.<span class="fn">summary</span>()<span class="caret"></span></code></pre>
      </div>
      <div class="cell-out">
        <span class="prompt out reveal" style="--d:250ms">Out[1]:</span>
        <div>
          <div class="who reveal" style="--d:300ms">
            <img src="/photo.png" alt="Kevin Leichen" width="64" height="64" />
            <div>
              <p class="role">{c.role}</p>
              <p class="role-sub">{c.roleSub}</p>
            </div>
          </div>
          <h1 class="reveal" style="--d:380ms">Kevin Leichen</h1>
          <p class="lede reveal" style="--d:460ms">{c.lede}</p>
          <p class="pitch reveal" style="--d:520ms">{c.pitch}</p>
          <div class="ctas reveal" style="--d:580ms">
            <a class="btn btn-primary" href="#projects">{c.seeCases} <Fragment set:html={svg(icon.arrow)} /></a>
            <a class="btn btn-ghost" href="#contact">{t(lang, 'hero.cta')}</a>
            <a class="btn btn-ghost" href={cvHref} download>{t(lang, 'hero.cv')} <Fragment set:html={svg(icon.download)} /></a>
          </div>
        </div>
      </div>
    </div>

    {metrics.length > 0 && (
      <figure class="fig chart reveal" style="--d:300ms">
        <figcaption>
          <span class="fig-title">{c.fig1}</span>
          <span class="legend">
            <span><i class="lg before"></i>{c.fig1Before}</span>
            <span><i class="lg after"></i>{c.fig1After}</span>
          </span>
        </figcaption>
        <div class="rows">
          {metrics.map((m, i) => {
            const th = theme(m.page);
            const p = byPage.get(m.page)!;
            return (
              <a class="row" href={projectPath(lang, m.page)} style={`--c:${th.accent};--b:${m.before}%;--a:${m.after}%;--i:${i}`}
                data-title={p.data.title} data-before={m.beforeLabel[lang]} data-after={m.afterLabel[lang]} data-detail={m.detail[lang]}>
                <span class="row-label"><span class="row-field">{th.short[lang]}</span>{m.label[lang]}</span>
                <span class="track">
                  <span class="span"></span>
                  <span class="pt before"></span>
                  <span class="pt after"><span class="val">{Math.round(m.after)}%</span></span>
                </span>
              </a>
            );
          })}
        </div>
        <div class="axis" aria-hidden="true"><span>0</span><span>25</span><span>50</span><span>75</span><span>100%</span></div>
        <div class="detail" aria-live="polite" style={`--c:${theme(metrics[0].page).accent}`}>
          <div class="tt-title">{byPage.get(metrics[0].page)!.data.title}</div>
          <div class="tt-ba"><span class="tt-before">{metrics[0].beforeLabel[lang]}</span><span class="tt-after">{metrics[0].afterLabel[lang]}</span></div>
          <div class="tt-detail">{metrics[0].detail[lang]}</div>
        </div>
        <p class="hint">{c.fig1Hint}</p>
      </figure>
    )}
  </div>
</section>

<!-- ===== Cases as a dataframe ===== -->
<section id="projects" class="alt">
  <div class="container">
    <header class="sec reveal">
      <span class="prompt">In&nbsp;[2]:</span>
      <code class="sec-code">cases.<span class="fn">sort_values</span>(<span class="str">"date"</span>, ascending=<span class="kw">False</span>)</code>
      <h2>{c.casesTitle}</h2>
      <p>{c.casesSub}</p>
    </header>

    <div class="df-wrap reveal">
      <div class="df" role="table">
        <div class="df-head" role="row">
          <span role="columnheader" class="idx"></span>
          {c.cols.map((col) => <span role="columnheader">{col}</span>)}
        </div>
        {projects.map((p, i) => {
          const th = theme(p.data.page);
          const h = p.data.highlights[0];
          return (
            <a class:list={['df-row', { on: i === 0 }]} role="row" href={projectPath(lang, p.data.page)} data-i={i} style={`--c:${th.accent}`}>
              <span role="cell" class="idx">{i}</span>
              <span role="cell" class="df-case">{p.data.title}</span>
              <span role="cell" class="df-field">{th.field[lang]}</span>
              <span role="cell" class="df-method">{th.method[lang]}</span>
              <span role="cell" class="df-result">{h && <><b>{h.value}</b> <span>{h.label}</span></>}</span>
            </a>
          );
        })}
        <p class="df-shape">{c.shape(projects.length)}</p>
      </div>

      <div class="previews">
        {projects.map((p, i) => {
          const th = theme(p.data.page);
          return (
            <a class:list={['pv', { on: i === 0 }]} data-i={i} href={projectPath(lang, p.data.page)} style={`--c:${th.accent};--paper:${th.paper}`}>
              <div class="pv-cover"><img src={p.data.cover} alt="" loading={i === 0 ? 'eager' : 'lazy'} /></div>
              <div class="pv-body">
                <p class="pv-meta">{th.field[lang]} · {th.method[lang]}{p.data.embed && <> · <span>{c.tool}</span></>}</p>
                <h3>{p.data.title}</h3>
                <p class="pv-sum">{p.data.summary}</p>
                <dl class="kpis">
                  {p.data.highlights.slice(0, 3).map((h) => <div><dt>{h.value}</dt><dd>{h.label}</dd></div>)}
                </dl>
                <div class="pv-foot">
                  <div class="chips">{p.data.tools.slice(0, 5).map((tool) => <span class="chip">{tool}</span>)}</div>
                  <span class="go">{c.open} <Fragment set:html={svg(icon.arrow)} /></span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</section>

<!-- ===== Process as a pipeline ===== -->
<section id="services">
  <div class="container">
    <header class="sec reveal">
      <span class="prompt">In&nbsp;[3]:</span>
      <code class="sec-code">pipeline.<span class="fn">run</span>(raw_data)</code>
      <h2>{c.processTitle}</h2>
      <p>{c.processSub}</p>
    </header>
    <ol class="pipe">
      {process.map((s, i) => (
        <li class="node reveal" style={`--d:${i * 100}ms`}>
          <code class="node-fn">{processFns[i]}</code>
          <h3>{s.title[lang]}</h3>
          <p>{s.desc[lang]}</p>
          <span class="node-ex"># {c.example} {s.example[lang]}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- ===== Tools heatmap ===== -->
<section class="alt" id="tools">
  <div class="container">
    <header class="sec reveal">
      <span class="prompt">In&nbsp;[4]:</span>
      <code class="sec-code">pd.<span class="fn">crosstab</span>(tools, cases)</code>
      <h2>{c.heatTitle}</h2>
      <p>{c.heatSub}</p>
    </header>
    <div class="heat-wrap reveal">
      <table class="heat">
        <thead>
          <tr>
            <th></th>
            {projects.map((p) => <th style={`--c:${theme(p.data.page).accent}`}>{theme(p.data.page).short[lang]}</th>)}
            <th class="tot">{c.heatTotal}</th>
          </tr>
        </thead>
        <tbody>
          {heatRows.map((r) => (
            <tr>
              <th>{r.tool}</th>
              {projects.map((p) => {
                const on = r.cases.includes(p);
                return (
                  <td class:list={['cell', { on }]} style={`--c:${theme(p.data.page).accent}`} tabindex={on ? 0 : undefined}
                    data-tip={on ? c.heatUsed(r.tool, p.data.title) : undefined}>
                    {on ? '1' : '0'}
                  </td>
                );
              })}
              <td class="tot"><span class="bar" style={`--w:${(r.cases.length / projects.length) * 100}%`}></span>{r.cases.length}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {alsoUse.length > 0 && <p class="also"><span>{c.heatAlso}</span> {alsoUse.join(' · ')}</p>}
    </div>
  </div>
</section>

<!-- ===== About + gantt ===== -->
<section id="about">
  <div class="container about-grid">
    <div class="portrait reveal">
      <img src="/photo.png" alt="Kevin Leichen" width="600" height="600" loading="lazy" />
    </div>
    <div class="about-copy">
      <header class="sec reveal">
        <span class="prompt">In&nbsp;[5]:</span>
        <code class="sec-code">kevin.<span class="fn">describe</span>()</code>
        <h2>{c.aboutTitle}</h2>
      </header>
      <p class="reveal">{t(lang, 'about.p1')}</p>
      <p class="reveal">{t(lang, 'about.p2')}</p>
      <p class="reveal">{t(lang, 'about.p3')}</p>
      <table class="kv reveal">
        <tr><th>{c.kv.year}</th><td>{t(lang, 'about.year')}</td></tr>
        <tr><th>{c.kv.cases}</th><td>{projects.length}</td></tr>
        <tr><th>{c.kv.english}</th><td>C1</td></tr>
        <tr><th>{c.kv.city}</th><td>Buenos Aires</td></tr>
      </table>
    </div>

    <figure class="fig gantt reveal">
      <figcaption><span class="fig-title">{c.fig2}</span></figcaption>
      <div class="g-rows">
        {career.map((e, i) => {
          const s = monthIdx(e.start), en = e.end ? monthIdx(e.end) : nowIdx;
          return (
            <div class="g-row" style={`--i:${i}`}>
              <span class="g-label"><strong>{e.label[lang]}</strong><span>{e.where[lang]}</span></span>
              <span class="g-track">
                <span class:list={['g-bar', e.kind, { live: !e.end }]} style={`--s:${(s / span) * 100}%;--w:${((en - s + 1) / span) * 100}%`}></span>
              </span>
            </div>
          );
        })}
      </div>
      <div class="g-axis">
        <span></span>
        <span class="g-ticks">
          {years.map((y) => <span style={`left:${(monthIdx(`${y}-01`) / span) * 100}%`}>{y}</span>)}
          <span class="now" style="left:100%">{c.now}</span>
        </span>
      </div>
    </figure>
  </div>
</section>

<!-- ===== Contact ===== -->
<section id="contact" class="alt">
  <div class="container contact-grid">
    <div class="reveal">
      <header class="sec">
        <span class="prompt">In&nbsp;[6]:</span>
        <code class="sec-code">kevin.<span class="fn">contact</span>()</code>
        <h2>{c.contactTitle}</h2>
        <p>{c.contactSub}</p>
      </header>
      <div class="direct">
        <a class="btn btn-ghost" href={`https://wa.me/${contact.whatsapp}`} target="_blank" rel="noopener">
          <Fragment set:html={svg(icon.chat)} /> {t(lang, 'contact.whatsapp')}
        </a>
        <a class="btn btn-ghost" href={contact.github} target="_blank" rel="noopener"><Fragment set:html={svg(icon.github)} /> GitHub</a>
      </div>
    </div>
    <form class="card form reveal" id="contact-form" data-key={contact.web3formsKey} data-mail={contact.email}
      data-sending={t(lang, 'contact.sending')} data-ok={t(lang, 'contact.ok')} data-err={t(lang, 'contact.err')}>
      <div class="frow">
        <label><span><code>name=</code> {t(lang, 'contact.name')}</span><input name="name" required autocomplete="name" /></label>
        <label><span><code>email=</code> {t(lang, 'contact.email')}</span><input name="email" type="email" required autocomplete="email" /></label>
      </div>
      <label><span><code>message=</code> {t(lang, 'contact.message')}</span><textarea name="message" rows="5" required></textarea></label>
      <button class="btn btn-primary mono-btn" type="submit">{c.send} <Fragment set:html={svg(icon.arrow)} /></button>
      <p class="fstatus" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  // Contact form
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = form.querySelector('.fstatus') as HTMLElement;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = form.dataset;
    const data = new FormData(form);
    if (!d.key) {
      // No form service key yet: open the visitor's email app instead.
      const body = `${data.get('message')}\n\n${data.get('name')} <${data.get('email')}>`;
      location.href = `mailto:${d.mail}?subject=${encodeURIComponent('Portfolio: ' + data.get('name'))}&body=${encodeURIComponent(body)}`;
      return;
    }
    status.textContent = d.sending!;
    data.append('access_key', d.key);
    data.append('subject', 'Portfolio: ' + data.get('name'));
    try {
      const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: data });
      if (!res.ok) throw new Error();
      status.textContent = d.ok!;
      form.reset();
    } catch {
      status.textContent = d.err!;
    }
  });

  // Fig. 1: hovering a row fills the detail panel.
  const chart = document.querySelector('.chart') as HTMLElement | null;
  if (chart) {
    const panel = chart.querySelector('.detail') as HTMLElement;
    const set = (sel: string, text: string) => { (panel.querySelector(sel) as HTMLElement).textContent = text; };
    const show = (row: HTMLElement) => {
      const d = row.dataset;
      set('.tt-title', d.title!); set('.tt-before', d.before!); set('.tt-after', d.after!); set('.tt-detail', d.detail!);
      panel.style.setProperty('--c', getComputedStyle(row).getPropertyValue('--c'));
      chart.classList.add('focus');
      chart.querySelectorAll('.row').forEach((r) => r.classList.toggle('on', r === row));
    };
    chart.querySelectorAll<HTMLElement>('.row').forEach((row) => {
      row.addEventListener('mouseenter', () => show(row));
      row.addEventListener('focus', () => show(row));
    });
    chart.addEventListener('mouseleave', () => chart.classList.remove('focus'));
  }

  // Cases dataframe: hovering a row swaps the preview card.
  const rows = [...document.querySelectorAll<HTMLElement>('.df-row')];
  const pvs = [...document.querySelectorAll<HTMLElement>('.pv')];
  const pick = (i: string) => {
    rows.forEach((r) => r.classList.toggle('on', r.dataset.i === i));
    pvs.forEach((p) => p.classList.toggle('on', p.dataset.i === i));
  };
  rows.forEach((r) => {
    r.addEventListener('mouseenter', () => pick(r.dataset.i!));
    r.addEventListener('focus', () => pick(r.dataset.i!));
  });
</script>

<style>
  /* ---------- Notebook hero ---------- */
  .hero { padding: 64px 0 96px; }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 56px; align-items: center; }
  .prompt { font-family: var(--mono); font-size: .78rem; color: var(--faint); white-space: nowrap; }
  .prompt.out { color: #e0a443; }
  .cell-in, .cell-out { display: grid; grid-template-columns: 64px 1fr; gap: 12px; align-items: start; }
  .cell-in .prompt, .cell-out .prompt { padding-top: 14px; text-align: right; }
  .code {
    margin: 0; padding: 12px 16px; background: rgba(23, 34, 44, .75); border: 1px solid var(--border-soft);
    border-left: 3px solid var(--accent); border-radius: 10px; font-family: var(--mono); font-size: .86rem; line-height: 1.7;
    overflow-x: auto; color: var(--text);
  }
  .kw { color: #c792ea; }
  .fn { color: #82aaff; }
  .str { color: #c3e88d; }
  .caret { display: inline-block; width: 8px; height: 1.1em; vertical-align: -3px; margin-left: 3px; background: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .cell-out { margin-top: 22px; }
  .who { display: flex; align-items: center; gap: 14px; margin: 8px 0 18px; }
  .who img { width: 64px; height: 64px; border-radius: 12px; object-fit: cover; border: 1px solid var(--border); }
  .who p { margin: 0; }
  .role { font-weight: 600; display: flex; align-items: center; gap: 8px; }
  .role::after { content: 'open_to_work'; font-family: var(--mono); font-size: .68rem; font-weight: 500; color: #5ee08a; border: 1px solid rgba(94, 224, 138, .4); padding: 1px 7px; border-radius: 999px; }
  .role-sub { color: var(--muted); font-size: .88rem; }
  h1 { font-size: clamp(3rem, 7.4vw, 5.6rem); line-height: .95; }
  .lede { font-size: clamp(1.25rem, 2.2vw, 1.6rem); line-height: 1.3; margin: 18px 0 12px; font-weight: 600; color: var(--accent); max-width: 22em; }
  .pitch { color: var(--muted); font-size: 1.02rem; max-width: 34em; margin: 0 0 28px; }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; }

  /* ---------- Figures ---------- */
  .fig { margin: 0; padding: 22px 22px 16px; background: var(--surface); border: 1px solid var(--border-soft); border-radius: 14px; position: relative; }
  figcaption { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
  .fig-title { font-family: var(--mono); font-size: .82rem; color: var(--text); }
  .legend { display: flex; gap: 14px; font-size: .74rem; color: var(--muted); font-family: var(--mono); }
  .legend span { display: inline-flex; align-items: center; gap: 6px; }
  .lg { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .lg.before { border: 2px solid var(--faint); }
  .lg.after { background: var(--accent); }
  .rows { display: grid; gap: 4px; }
  .row { display: grid; gap: 6px; padding: 9px 10px 11px; margin: 0 -10px; border-radius: 8px; transition: background .2s, opacity .25s; }
  .chart.focus .row:not(.on) { opacity: .4; }
  .row.on { background: var(--surface-2); }
  .row-label { font-size: .88rem; display: flex; gap: 10px; align-items: baseline; }
  .row-field { font-family: var(--mono); font-size: .7rem; color: var(--c); min-width: 6.5em; }
  .track {
    position: relative; height: 16px; margin-right: 44px;
    background: repeating-linear-gradient(90deg, var(--border-soft) 0 1px, transparent 1px 25%);
    background-size: calc(100% + 1px) 100%;
  }
  .track::before { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: var(--border); }
  .span { position: absolute; top: 50%; height: 3px; margin-top: -1.5px; left: var(--b); width: calc(var(--a) - var(--b)); background: linear-gradient(90deg, rgba(147, 165, 181, .25), var(--c)); transform-origin: 0 50%; }
  .pt { position: absolute; top: 50%; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 50%; }
  .pt.before { left: var(--b); background: var(--bg); border: 2px solid var(--faint); }
  .pt.after { left: var(--a); background: var(--c); box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 25%, transparent); }
  .val { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); font-family: var(--mono); font-size: .74rem; color: var(--c); }
  .js .chart .span { transform: scaleX(0); transition: transform 1s var(--ease); transition-delay: calc(500ms + var(--i) * 140ms); }
  .js .chart .pt.after { left: var(--b); transition: left 1s var(--ease); transition-delay: calc(500ms + var(--i) * 140ms); }
  .js .chart.in .span { transform: none; }
  .js .chart.in .pt.after { left: var(--a); }
  .axis { display: flex; justify-content: space-between; margin: 4px 44px 0 0; font-family: var(--mono); font-size: .66rem; color: var(--faint); }
  .detail { margin-top: 14px; padding: 12px 14px; border-radius: 10px; background: var(--bg); border: 1px solid var(--border-soft); border-left: 3px solid var(--c); font-size: .86rem; }
  .tt-title { font-weight: 600; margin-bottom: 4px; }
