---
import '../styles/global.css';
import { t, homePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  altHref: string; // same page in the other language
}
const { lang, title, description, altHref } = Astro.props;
const home = homePath(lang);
const links = [
  ['nav.projects', '#projects'],
  ['nav.services', '#services'],
  ['nav.about', '#about'],
  ['nav.contact', '#contact'],
] as const;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" hreflang={lang === 'es' ? 'en' : 'es'} href={altHref} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <meta name="theme-color" content="#0e151b" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
        <header class="nav">
      <div class="container nav-inner">
        <a href={home} class="brand"><span class="mark" aria-hidden="true">&gt;_</span><span>kevin_leichen<span class="ext">.ipynb</span></span></a>
        <nav class="links" aria-label="Main">
          {links.map(([key, hash]) => <a href={home + hash}>{t(lang, key)}</a>)}
        </nav>
        <div class="lang" role="group" aria-label="Language">
          <a href={lang === 'es' ? undefined : altHref} class:list={[{ on: lang === 'es' }]} aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
          <a href={lang === 'en' ? undefined : altHref} class:list={[{ on: lang === 'en' }]} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        </div>
      </div>
    </header>
    <main><slot /></main>
    <footer class="footer">
      <div class="container foot-inner">
        <span>© {new Date().getFullYear()} Kevin Leichen · {lang === 'es' ? 'Los nombres y logos de herramientas son marcas de sus dueños.' : 'Product names and logos are trademarks of their owners.'}</span>
        <span class="foot-mono">Buenos Aires · {lang === 'es' ? 'último build' : 'last build'} {new Date().toISOString().slice(0, 10)} · {t(lang, 'footer')}</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .nav {
    position: sticky; top: 0; z-index: 10;
    background: rgba(14, 21, 27, 0.9); backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--border-soft);
  }
  .nav-inner { display: flex; align-items: center; gap: 32px; height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-family: var(--mono); font-size: .92rem; }
  .ext { color: var(--muted); }
  .mark {
    font-family: var(--mono); font-size: .75rem; width: 30px; height: 30px; display: grid; place-items: center;
    border-radius: 8px; border: 1px solid var(--accent); color: var(--accent);
  }
  .links { display: flex; gap: 6px; margin-left: auto; }
  .links a {
    position: relative; color: var(--muted); font-weight: 500; font-size: .82rem; font-family: var(--mono); padding: 6px 12px;
    transition: color var(--m-out);
  }
  .links a::after {
    content: ''; position: absolute; left: 12px; right: 12px; bottom: 0; height: 1px; background: currentColor;
    transform: scaleX(0); transform-origin: right; transition: transform var(--m-out) var(--ease);
  }
  .links a:hover { color: var(--text); transition-duration: var(--m-in); }
  .links a:hover::after { transform: scaleX(1); transform-origin: left; transition-duration: var(--m-in); }
  .lang {
    display: flex; background: var(--surface); border: 1px solid var(--border-soft);
    border-radius: 999px; padding: 3px; font-family: var(--mono);
  }
  .lang a { padding: 3px 11px; border-radius: 999px; font-size: .78rem; font-weight: 500; color: var(--muted); }
  .lang a[href]:hover { color: var(--text); }
  .lang a.on { background: var(--accent); color: var(--accent-ink); }
  .footer { border-top: 1px solid var(--border-soft); padding: 32px 0; color: var(--faint); font-size: .88rem; }
  .foot-inner { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .foot-mono { font-family: var(--mono); font-size: .78rem; }
  @media (max-width: 820px) {
    .nav-inner { flex-wrap: wrap; height: auto; padding-top: 10px; gap: 8px 16px; }
    .lang { margin-left: auto; }
    .links { order: 3; width: 100%; margin: 0 -12px; overflow-x: auto; padding-bottom: 8px; scrollbar-width: none; }
    .links a { white-space: nowrap; }
  }
</style>
